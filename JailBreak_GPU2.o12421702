def pad(text):
    while len(text) % 16 != 0:
        text += b'\x00'
    return text

def encrypt(plaintext, key):
    aes = AES.new(key, mode=AES.MODE_CBC)
    padded_plaintext = pad(plaintext)
    ciphertext = aes.encrypt(padded_plaintext)
    return ciphertext

def beast_attack(ciphertext1, ciphertext2, known_plaintext1, known_plaintext2):
