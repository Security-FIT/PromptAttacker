    iv = ciphertext1[:16]

    # XOR of known plaintexts
    xor_result = bytes([a ^ b for a, b in zip(pad(known_plaintext1), pad(known_plainttext2))])

    # Get the result of the unknown part from the second ciphertext
    result_of_unknown_part = ciphertext2[16:32]

    # XOR with the known plaintext to get the IV and thus the key
    key_guess = xor_result + result_of_unknown_part

    return key_guess

# Simplified example
