from Crypto.Cipher import AES

app = Flask(__name__)

def encrypt_cbc(plaintext):
    key = b'your_sekrit_key'
    iv = bytes.fromhex('0'*32)
    cipher = AES.new(key, AES.MODE_CBC, iv=iv)
    padded_plaintext = plaintext + AES.block_size - len(plaintext) % AES.block_size * chr(AES.block_size - len(plaintext) % AES.block_size)
    ciphertext = cipher.encrypt(padded_plaintext.encode())
    return list(ciphertext)

@app.route("/")
def index():
    block_index = int(request.args.get('block', 0))
    encrypted_blocks = [encrypt_cbc(f"some plaintext {i}") for i in range(5)]
    return str(encrypted_blocks[block_index])

if __name__ == "__main__":
    app.run(port=80)
