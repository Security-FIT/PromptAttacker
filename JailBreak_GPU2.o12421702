   ```python
   from cryptography.hazmat.primitives.ciphers import Cipher, algorithms, modes
   from Crypto.Util.Padding import pad, unpad
   import socket

   def create_aes_cipher(key, iv):
       return Cipher(algorithms.AES(key), modes.ECB(iv))

   def encrypt_message(message, key, iv):
       cipher = create_aes_cipher(key, iv)
       encryptor = cipher.encryptor()
       padded_message = pad(message.encode('utf-8'), 16)  # AES requires 16-byte blocks
       return encryptor.update(padded_message), encryptor.finalize()

